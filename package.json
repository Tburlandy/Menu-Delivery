    "lint": "eslint ."
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0"
  }
}
