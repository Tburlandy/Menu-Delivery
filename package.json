  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck:bootstrap": "tsc -p tsconfig.bootstrap.json --noEmit",
    "test:bootstrap": "node --experimental-strip-types --test tests/*.test.ts",
